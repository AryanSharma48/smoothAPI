      ]
    },
    {
      "id": "CB08", "description": "Failure recorded while OPEN extends the cooldown",
      "failure_threshold": 2, "cooldown_ms": 1000, "spec_status": "normative", "tags": ["failure_while_open"],
      "steps": [
        { "op": "record_failure", "t": 0, "expect": { "state": "CLOSED", "failure_count": 1 } },
        { "op": "record_failure", "t": 100, "expect": { "state": "OPEN", "failure_count": 2 } },
        { "op": "record_failure", "t": 500, "expect": { "state": "OPEN", "failure_count": 3 } },
        { "op": "can_request", "t": 1200, "expect": { "ret": false, "state": "OPEN", "failure_count": 3 } },
        { "op": "can_request", "t": 1501, "expect": { "ret": true, "state": "HALF_OPEN", "failure_count": 3 } }
      ]
    },
    {
      "id": "CB09", "description": "Observed state after cooldown elapses but before any request (stored vs effective state)",
      "failure_threshold": 1, "cooldown_ms": 1000, "spec_status": "ambiguous", "tags": ["state_observation"],
      "steps": [
        { "op": "record_failure", "t": 0, "expect": { "state": "OPEN", "failure_count": 1 } },
        { "op": "observe", "t": 1001, "expect": {} }
