    { "id": "B20", "base_delay_ms": "1", "max_delay_ms": "18446744073709551615", "attempt": 64, "expected_ms": "18446744073709551615", "tags": ["u64_max", "exceeds_i64", "exceeds_js_safe_integer", "cap"] }
  ],
