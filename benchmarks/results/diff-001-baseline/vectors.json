      "steps": [
        { "op": "record_failure", "t": 300, "expect": { "state": "OPEN", "failure_count": 1 } },
        { "op": "can_request", "t": 5300, "expect": { "ret": false, "state": "OPEN", "failure_count": 1 } },
        { "op": "can_request", "t": 5301, "expect": { "ret": true, "state": "HALF_OPEN", "failure_count": 1 } }
      ]
    },
    {
