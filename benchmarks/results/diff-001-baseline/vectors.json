{
  "schema_version": 1,
  "description": "Canonical differential test vectors for SmoothAPI resilience semantics. Expected values are derived from documented SmoothAPI behaviour and the governing HTTP specification, NOT from any single implementation.",
  "conventions": {
    "integers": "All delay/threshold integers that may exceed 2^53 are encoded as decimal strings. Runners must parse them with arbitrary-precision or u64 types and report outputs as decimal strings.",
    "time_unit": "All delays and timestamps are integer milliseconds.",
    "retry_after": "null means the Retry-After header is absent. HTTP-date Retry-After is intentionally excluded: it is not supported consistently across implementations.",
    "spec_status": "'normative' vectors are scored pass/fail. 'ambiguous' vectors have no documented answer; values are reported side-by-side without scoring."
  },
  "semantics": {
    "backoff_deterministic": "delay = min(max_delay_ms, base_delay_ms * 2^attempt), computed with exact integer arithmetic. Jitter disabled.",
    "retry_policy": {
      "success": "2xx status -> Success.",
      "retryable": "Status in retry_on [429, 500, 502, 503, 504] -> Retry while attempt < max_retries, otherwise Exhausted.",
      "terminal": "Any other status -> Terminal (returned to caller, never retried).",
      "delay": "Retry delay = deterministic backoff for the current attempt.",
      "retry_after": "Only for 429: a Retry-After value that is a valid RFC 9110 delta-seconds (1*DIGIT, surrounding whitespace allowed) and > 0 overrides the delay with seconds*1000. Retry-After is not capped by max_delay_ms. Invalid or non-positive values are ignored."
    },
    "circuit_breaker": {
      "trip": "CLOSED -> OPEN when consecutive failure count >= failure_threshold.",
      "reset": "record_success in CLOSED resets failure count to 0.",
      "cooldown": "OPEN rejects requests until (now - last_failure_time) > cooldown_ms (strict). The first allowed request transitions to HALF_OPEN.",
      "single_probe": "While HALF_OPEN with a probe in flight, further requests are rejected (anti-flapping, documented in the enhanced circuit breaker).",
      "half_open_failure": "A failure in HALF_OPEN re-trips to OPEN immediately and restarts the cooldown.",
      "half_open_success": "With success_threshold = 1, a success in HALF_OPEN closes the circuit and resets the failure count.",
      "failure_while_open": "A failure recorded while OPEN updates last_failure_time, extending the cooldown."
    }
  },
