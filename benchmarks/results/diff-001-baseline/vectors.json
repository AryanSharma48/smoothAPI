      "failure_threshold": 1, "cooldown_ms": 5000, "spec_status": "normative", "tags": ["cooldown_boundary", "fractional_seconds"],
      "steps": [
        { "op": "record_failure", "t": 700, "expect": { "state": "OPEN", "failure_count": 1 } },
