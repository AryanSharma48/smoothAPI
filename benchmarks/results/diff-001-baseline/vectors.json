  "circuit_breaker": [
    {
      "id": "CB01", "description": "Trip at threshold, strict cooldown boundary, HALF_OPEN probe success closes",
      "failure_threshold": 3, "cooldown_ms": 5000, "spec_status": "normative", "tags": ["trip", "cooldown_boundary", "recovery"],
      "steps": [
        { "op": "record_failure", "t": 1000, "expect": { "state": "CLOSED", "failure_count": 1 } },
        { "op": "record_failure", "t": 2000, "expect": { "state": "CLOSED", "failure_count": 2 } },
        { "op": "record_failure", "t": 3000, "expect": { "state": "OPEN", "failure_count": 3 } },
        { "op": "can_request", "t": 5000, "expect": { "ret": false, "state": "OPEN", "failure_count": 3 } },
        { "op": "can_request", "t": 8000, "expect": { "ret": false, "state": "OPEN", "failure_count": 3 } },
        { "op": "can_request", "t": 8001, "expect": { "ret": true, "state": "HALF_OPEN", "failure_count": 3 } },
        { "op": "record_success", "t": 8002, "expect": { "state": "CLOSED", "failure_count": 0 } }
      ]
    },
    {
      "id": "CB02", "description": "Success in CLOSED resets consecutive failure count",
      "failure_threshold": 3, "cooldown_ms": 5000, "spec_status": "normative", "tags": ["reset"],
      "steps": [
        { "op": "record_failure", "t": 100, "expect": { "state": "CLOSED", "failure_count": 1 } },
        { "op": "record_failure", "t": 200, "expect": { "state": "CLOSED", "failure_count": 2 } },
        { "op": "record_success", "t": 300, "expect": { "state": "CLOSED", "failure_count": 0 } },
        { "op": "record_failure", "t": 400, "expect": { "state": "CLOSED", "failure_count": 1 } },
        { "op": "record_failure", "t": 500, "expect": { "state": "CLOSED", "failure_count": 2 } },
        { "op": "can_request", "t": 600, "expect": { "ret": true, "state": "CLOSED", "failure_count": 2 } }
      ]
    },
    {
      "id": "CB03", "description": "HALF_OPEN failure re-trips and restarts cooldown",
      "failure_threshold": 2, "cooldown_ms": 1000, "spec_status": "normative", "tags": ["half_open_retrip", "cooldown_boundary"],
      "steps": [
        { "op": "record_failure", "t": 100, "expect": { "state": "CLOSED", "failure_count": 1 } },
        { "op": "record_failure", "t": 200, "expect": { "state": "OPEN", "failure_count": 2 } },
        { "op": "can_request", "t": 1201, "expect": { "ret": true, "state": "HALF_OPEN", "failure_count": 2 } },
        { "op": "record_failure", "t": 1205, "expect": { "state": "OPEN", "failure_count": 3 } },
        { "op": "can_request", "t": 1300, "expect": { "ret": false, "state": "OPEN", "failure_count": 3 } },
        { "op": "can_request", "t": 2205, "expect": { "ret": false, "state": "OPEN", "failure_count": 3 } },
        { "op": "can_request", "t": 2206, "expect": { "ret": true, "state": "HALF_OPEN", "failure_count": 3 } },
        { "op": "record_success", "t": 2207, "expect": { "state": "CLOSED", "failure_count": 0 } }
      ]
    },
    {
      "id": "CB04", "description": "Single in-flight probe in HALF_OPEN (anti-flapping)",
      "failure_threshold": 1, "cooldown_ms": 1000, "spec_status": "normative", "tags": ["single_probe"],
      "steps": [
        { "op": "record_failure", "t": 0, "expect": { "state": "OPEN", "failure_count": 1 } },
        { "op": "can_request", "t": 1001, "expect": { "ret": true, "state": "HALF_OPEN", "failure_count": 1 } },
        { "op": "can_request", "t": 1002, "expect": { "ret": false, "state": "HALF_OPEN", "failure_count": 1 } },
        { "op": "record_success", "t": 1003, "expect": { "state": "CLOSED", "failure_count": 0 } }
      ]
    },
    {
      "id": "CB05", "description": "Cooldown boundary with non-whole-second timestamps (300ms offset)",
