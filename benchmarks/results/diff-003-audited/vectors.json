{
  "schema_version": 3,
  "description": "Canonical differential test vectors for SmoothAPI resilience semantics (v3 audited specification). Expected values are verified against an independent specification model.",
  "conventions": {
    "integers": "All delay/threshold integers are encoded as decimal strings. Runners parse them into native numeric types and report outputs as decimal strings.",
    "time_unit": "All delays and timestamps are integer milliseconds.",
    "retry_after": "null means the Retry-After header is absent. Only RFC 9110 delta-seconds (delay-seconds = 1*DIGIT, non-negative decimal integer) on HTTP 429 is supported; HTTP-date Retry-After and non-429 Retry-After are explicitly out of scope.",
    "categories": "'backoff', 'jitter', 'retry_policy', and 'circuit_breaker' are normative common-domain parity suites scored for 100% agreement across all 5 implementations. 'backoff_numeric_boundary' records language-specific numeric representation limits above 2^53-1 or non-binary-fraction float-seconds conversions separately."
  },
  "semantics": {
    "backoff_deterministic": "delay = min(max_delay_ms, base_delay_ms * 2^attempt) for base_delay_ms > 0 and max_delay_ms > 0, else 0. Cap-aware and overflow-safe without arbitrary attempt clamping.",
    "jitter": "Supports 'none', 'full', 'equal', and 'decorrelated', with 'equal' as the default strategy across all implementations. Evaluated deterministically under injected random_factor in [0.0, 1.0].",
    "retry_policy": {
      "success": "Status in 200..400 (2xx and 3xx) -> Success (no retry required).",
      "retryable": "Status in retry_on [429, 500, 502, 503, 504] -> Retry while attempt < max_retries, otherwise Exhausted.",
      "terminal": "Any other status -> Terminal (returned/propagated to caller, never retried).",
      "delay": "Retry delay = deterministic backoff for the current attempt.",
      "retry_after": "Scoped deliberately to HTTP 429: a Retry-After value that is a valid RFC 9110 delay-seconds (1*DIGIT after ASCII whitespace trim, i.e., non-negative integer >= 0) overrides the delay with seconds*1000. Negative, leading-plus, fractional, scientific, or trailing-garbage values are rejected. HTTP-date format is out of scope."
    },
    "circuit_breaker": {
      "trip": "CLOSED -> OPEN when consecutive failure count >= failure_threshold.",
      "reset": "record_success in CLOSED resets failure count to 0.",
      "cooldown": "OPEN rejects requests until (now - last_failure_time) > cooldown_ms (strict: t-1 is false, t is false, t+1 is true). The first allowed request transitions stored state to HALF_OPEN.",
      "single_probe": "While HALF_OPEN with an active probe in flight, further requests are rejected.",
      "probe_recovery": "If a HALF_OPEN probe is cancelled/aborted via release_probe(), or abandoned for longer than cooldown_ms ((now - probe_start_time) > cooldown_ms), a new probe is permitted so the circuit cannot wedge.",
      "half_open_failure": "A failure in HALF_OPEN re-trips to OPEN immediately and restarts the cooldown.",
      "half_open_success": "With success_threshold = 1, a success in HALF_OPEN closes the circuit and resets the failure count.",
      "failure_while_open": "A failure recorded while OPEN updates last_failure_time, extending the cooldown.",
      "state_inspection": "'state' reports the currently stored state without clock dependency; 'state_at(now_ms)' reports the effective state at timestamp now_ms (HALF_OPEN when stored state is OPEN and now_ms - last_failure_time > cooldown_ms)."
    }
  },
