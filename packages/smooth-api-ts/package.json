  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AryanSharma48/smoothAPI.git",
    "directory": "packages/smooth-api-ts"
  },
  "bugs": {
    "url": "https://github.com/AryanSharma48/smoothAPI/issues"
  },
  "homepage": "https://smoothapi.org",
